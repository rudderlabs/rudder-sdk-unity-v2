<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UnityApiCompatibility)' == 'true'">
    <TargetFramework>netstandard2.1</TargetFramework>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <ItemGroup Condition="'$(UnityApiCompatibility)' != 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.4.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(UnityApiCompatibility)' == 'true'">
    <Compile Remove="*Tests.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <Reference Include="RudderAnalytics" HintPath="../../Assets/RudderStack/Unity/Plugins/RudderAnalytics.dll" />
    <Reference Include="NodaTime" HintPath="../../Assets/RudderStack/Unity/Plugins/NodaTime.dll" />
    <Compile Include="../../Assets/RudderStack/Unity/Scripts/Client/*.cs" Link="SDK/Client/%(Filename)%(Extension)" />
    <Compile Include="../../Assets/RudderStack/Unity/Scripts/Helpers/*.cs" Link="SDK/Helpers/%(Filename)%(Extension)" />
    <Compile Include="../../Assets/RudderStack/Unity/Scripts/Models/*.cs" Exclude="../../Assets/RudderStack/Unity/Scripts/Models/RSPlayerSettings.cs" Link="SDK/Models/%(Filename)%(Extension)" />
    <None Include="../../Assets/RudderStack/Unity/Resources/package.json" Link="package.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
